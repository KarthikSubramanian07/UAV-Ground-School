<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>ugs_drone</name>
  <version>0.5.0</version>
  <description>The week 5 drone: camera, detector, planner and PX4 bridge nodes</description>
  <maintainer email="88288818+KarthikSubramanian07@users.noreply.github.com">Karthik Subramanian</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>std_srvs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>vision_msgs</exec_depend>
  <exec_depend>ugs_interfaces</exec_depend>
  <exec_depend>launch</exec_depend>
