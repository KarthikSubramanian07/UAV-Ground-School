# Protocol Pro: A 500 mm RTK survey quad: Cube Orange+ flight controller, Here4 RTK GNSS on DroneCAN, Jetson Orin Nano companion on DDS and MAVLink, SIYI gimbal camera, ExpressLRS control and a 900 MHz telemetry link.
# Firmware: ArduCopter 4.7.1 custom build with AP_DDS
# Generated by python -m week04 docs; every value validated against ArduCopter 4.7.1 parameter metadata
FRAME_CLASS,1  # quad
FRAME_TYPE,1  # X
SERIAL1_PROTOCOL,2  # TELEM1: MAVLink 2 (MAVLink to the ground station, and RTK corrections up to the drone)
SERIAL1_BAUD,57  # TELEM1: 57600 baud
BRD_SER1_RTSCTS,1  # TELEM1: hardware flow control on
SERIAL2_PROTOCOL,45  # TELEM2: DDS XRCE (ROS 2) (ROS 2 topics between the autopilot and the Jetson (DDS, the in drone half of the hybrid model))
SERIAL2_BAUD,921  # TELEM2: 921600 baud
BRD_SER2_RTSCTS,1  # TELEM2: hardware flow control on
DDS_ENABLE,1  # start the DDS client (needs a build with AP_DDS)
SERIAL3_PROTOCOL,8  # GPS1: SIYI gimbal serial (Gimbal angles and camera triggers from the autopilot)
SERIAL3_BAUD,115  # GPS1: 115200 baud
MNT1_TYPE,8  # SIYI gimbal
CAM1_TYPE,4  # camera triggered through the mount driver
MNT1_PITCH_MIN,-90  # gimbal can look straight down
MNT1_PITCH_MAX,25
MNT1_YAW_MIN,-135
MNT1_YAW_MAX,135
SERIAL4_PROTOCOL,23  # GPS2: CRSF (ExpressLRS) (Pilot sticks in, link statistics and telemetry out)
RSSI_TYPE,3  # RSSI from the receiver protocol
RC_OPTIONS,8704  # bit 9: suppress CRSF mode messages for ELRS, bit 13: 420 kbaud for ELRS
MAV2_RAW_SENS,1  # TELEM1 is MAVLink channel 2
MAV2_EXT_STAT,2  # TELEM1 is MAVLink channel 2
MAV2_RC_CHAN,1  # TELEM1 is MAVLink channel 2
MAV2_POSITION,3  # TELEM1 is MAVLink channel 2
MAV2_EXTRA1,4  # TELEM1 is MAVLink channel 2
MAV2_EXTRA2,2  # TELEM1 is MAVLink channel 2
MAV2_EXTRA3,2  # TELEM1 is MAVLink channel 2
MAV2_PARAMS,0  # TELEM1 is MAVLink channel 2
MAV2_ADSB,2  # TELEM1 is MAVLink channel 2
MAV1_RAW_SENS,0  # USB_GH is MAVLink channel 1
MAV1_EXT_STAT,2  # USB_GH is MAVLink channel 1
MAV1_RC_CHAN,0  # USB_GH is MAVLink channel 1
MAV1_POSITION,10  # USB_GH is MAVLink channel 1
MAV1_EXTRA1,20  # USB_GH is MAVLink channel 1
MAV1_EXTRA2,4  # USB_GH is MAVLink channel 1
MAV1_EXTRA3,2  # USB_GH is MAVLink channel 1
MAV1_PARAMS,0  # USB_GH is MAVLink channel 1
MAV1_ADSB,0  # USB_GH is MAVLink channel 1
CAN_P1_DRIVER,1  # CAN1 uses the first CAN driver
CAN_D1_PROTOCOL,1  # DroneCAN
CAN_P1_BITRATE,1000000  # 1 Mbit/s
GPS1_TYPE,9  # Here4 on DroneCAN
GPS_AUTO_CONFIG,1  # let ArduPilot configure the receiver
BRD_SAFETY_DEFLT,0  # the Here4 has no safety switch
RNGFND1_TYPE,25  # Benewake TFmini on I2C
RNGFND1_ADDR,16  # 0x10
RNGFND1_ORIENT,25  # pointing down
RNGFND1_MIN,0.1  # metres (4.7 uses metres)
RNGFND1_MAX,6  # metres, outdoor figure from the ArduPilot wiki
BATT_MONITOR,4  # analog voltage and current
BATT_VOLT_MULT,18.182  # PM02 V3 divider (the board default is for the Power Brick Mini)
BATT_AMP_PERVLT,36.364  # PM02 V3 current scale
BATT_CAPACITY,5000  # mAh
BATT_LOW_VOLT,14  # 3.5 V per cell under load
BATT_CRT_VOLT,13.2  # 3.3 V per cell under load
BATT_FS_LOW_ACT,2  # RTL on low battery
BATT_FS_CRT_ACT,1  # land on critical battery
MOT_PWM_TYPE,5  # DShot300
SERVO_DSHOT_ESC,2  # BLHeli_S
SERVO9_FUNCTION,33  # AUX1 drives motor 1
SERVO10_FUNCTION,34  # AUX2 drives motor 2
SERVO11_FUNCTION,35  # AUX3 drives motor 3
SERVO12_FUNCTION,36  # AUX4 drives motor 4
SERVO1_FUNCTION,0  # MAIN outputs unused (motors are on AUX)
SERVO2_FUNCTION,0  # MAIN outputs unused (motors are on AUX)
SERVO3_FUNCTION,0  # MAIN outputs unused (motors are on AUX)
SERVO4_FUNCTION,0  # MAIN outputs unused (motors are on AUX)
MOT_THST_HOVER,0.601  # hover throttle predicted by week04.performance
MOT_BAT_VOLT_MAX,16.8  # voltage scaling of thrust
MOT_BAT_VOLT_MIN,13.2
FS_THR_ENABLE,1  # RC loss: RTL
FS_GCS_ENABLE,1  # ground station loss: RTL
FENCE_ENABLE,1  # geofence on
FENCE_RADIUS,300  # metres
FENCE_ALT_MAX,120  # metres, the US Part 107 ceiling
